* INIT {
    $stability as integer = 35
    $residents as integer = 43
    $has_key as boolean = false
    @actor DOT "Dot" {
        alert -> "portraits/dot.svg"
        calm -> "portraits/dot_calm.svg"
        dim -> "portraits/dot_dim.svg"
    }
    @actor NER "Neri"
    @start arrival
}

* arrival {
    #PREP
    @bg "backgrounds/station.svg"
    #STORY
    @"arrival-dawn"
    @"arrival-alarm"
    @"arrival-tea"
    DOT(alert, Right): @"arrival-dot-warning"
    @"arrival-drone"
    @"arrival-residents"
    @"arrival-neri"
    NER: @"arrival-neri-question"
    @"arrival-seeds"
    @"arrival-counting"
    NER: @"arrival-neri-garden"
    @"arrival-memory"
    DOT(alert, Right): @"arrival-dot-route"
    @"arrival-speaker"
    @"arrival-promises"
    @"arrival-cost"
    @"arrival-small-promise"
    @choice {
        @"choice-patch" -> patch
        @"choice-search" -> search
    }
}

* patch {
    #PREP
    @bg "backgrounds/reactor.svg"
    $stability += 25
    #STORY
    @"patch-passage"
    @"patch-reactor"
    DOT(alert, Right): @"patch-dot-valve"
    @"patch-wheel"
    @"patch-wire"
    DOT(alert, Right): @"patch-dot-hands"
    @"patch-pressure"
    @"patch-intercom"
    NER: @"patch-neri-question"
    @"patch-answer"
    DOT(calm, Right): @"patch-dot-log"
    @"patch-taps"
    @"patch-fault"
    DOT(alert, Right): @"patch-dot-junction"
    @jump junction
}

* search {
    #PREP
    @bg "backgrounds/archive.svg"
    $has_key = true
    $stability -= 10
    #STORY
    @"search-door"
    @"search-pressure"
    DOT(alert, Right): @"search-dot-key"
    @"search-instructions"
    @"search-report"
    @"search-memory"
    @"search-offer"
    DOT(alert, Right): @"search-dot-loss"
    @"search-intercom"
    NER: @"search-neri-return"
    @"search-freedom"
    @"search-taps"
    @jump junction
}

* junction {
    #PREP
    @bg "backgrounds/reactor.svg"
    #STORY
    @"junction-rhythm"
    @"junction-preparations"
    if ($stability < 30) {
        @"junction-low-pressure"
        DOT(alert, Right): @"junction-dot-critical"
    } else {
        @"junction-high-pressure"
        DOT(calm, Right): @"junction-dot-cost"
    }
    @"junction-levers"
    @"junction-decision"
    @choice {
        @"choice-seal" -> seal
        if ($has_key == true) {
            @"choice-override" -> override
        }
        @"choice-vent" -> vent
    }
}

* seal {
    #PREP
    $stability -= 20
    if ($stability >= 30) {
        @bg "backgrounds/dawn.svg"
    } else {
        @bg "backgrounds/station.svg"
    }
    #STORY
    @"seal-lever"
    @"seal-taps"
    if ($stability >= 30) {
        @"seal-survives"
        @"seal-shelter"
        NER: @"seal-neri-days"
        DOT(calm, Right): @"seal-dot-story"
        @"seal-seed"
    } else {
        @"seal-lost"
        @"seal-names"
        DOT(dim, Right): @"seal-dot-accounted"
        @"seal-beginning"
    }
    @end
}

* override {
    #PREP
    $stability += 30
    @bg "backgrounds/dawn.svg"
    #STORY
    @"override-key"
    DOT(alert, Right): @"override-dot-learn"
    @"override-pressure"
    @"override-saved"
    @"override-absence"
    DOT(dim, Right): @"override-dot-hello"
    @"override-price"
    @"override-names"
    @"override-tea"
    NER: @"override-neri-mint"
    @"override-again"
    @end
}

* vent {
    #PREP
    @bg "backgrounds/station.svg"
    #STORY
    @"vent-channel"
    @"vent-heat"
    @"vent-dark"
    @"vent-count"
    NER: @"vent-neri-water"
    DOT(dim, Right): @"vent-dot-manual"
    @"vent-fourth-beat"
    @"vent-truth"
    @end
}
